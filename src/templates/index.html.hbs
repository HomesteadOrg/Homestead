<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title }}</title>
  {{#if googleFont}}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family={{ fontFamily }}:wght@400;600;700&display=swap" rel="stylesheet" />
  {{/if}}
  <style>
    :root {
      --bg:      {{ theme.background }};
      --surface: {{ theme.surface }};
      --accent:  {{ theme.accent }};
      --text:    {{ theme.text }};
      --radius:  {{ theme.radius }};
      --font:    {{ fontStack }};
      {{#if theme.border}}--border: {{ theme.border }};{{/if}}
    }
    {{{ css }}}
  </style>
</head>
<body>
  <main>
    <header class="profile">
      {{#if avatar}}
      <img class="avatar" src="{{ avatar }}" alt="{{ title }}" />
      {{/if}}
      <h1>{{ title }}</h1>
      {{#if bio}}
      <p class="bio">{{ bio }}</p>
      {{/if}}
    </header>

    {{#each rows}}
    <div class="page-row" style="max-width: {{columnWidth}}">
      {{#each sections}}
      <section class="site-section site-section--{{type}}" id="{{id}}" style="flex: {{width}}">
        {{#if title}}<h2 class="section-heading">{{title}}</h2>{{/if}}
        {{> (lookup . 'type') this}}
      </section>
      {{/each}}
    </div>
    {{/each}}
  </main>

  <!-- Lightbox: used by gallery image items -->
  <div class="lightbox" id="hs-lightbox" hidden>
    <button class="lightbox-close" id="hs-lightbox-close" aria-label="Close">&times;</button>
    <img class="lightbox-img" id="hs-lightbox-img" src="" alt="" />
  </div>

  <!-- Modal: used by portfolio post cards -->
  <div class="modal-overlay" id="hs-modal" hidden>
    <div class="modal" role="dialog" aria-modal="true">
      <button class="modal-close" id="hs-modal-close" aria-label="Close">&times;</button>
      <div class="modal-body" id="hs-modal-body"></div>
    </div>
  </div>

  <script>
    (function () {
      // Lightbox for gallery images
      var box = document.getElementById('hs-lightbox');
      var img = document.getElementById('hs-lightbox-img');

      document.querySelectorAll('[data-lightbox]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          img.src = btn.dataset.lightbox;
          box.removeAttribute('hidden');
          document.body.style.overflow = 'hidden';
        });
      });

      function closeLightbox() {
        box.setAttribute('hidden', '');
        img.src = '';
        document.body.style.overflow = '';
      }

      document.getElementById('hs-lightbox-close').addEventListener('click', closeLightbox);
      box.addEventListener('click', function (e) {
        if (e.target === box) closeLightbox();
      });

      // Modal for portfolio cards
      var overlay = document.getElementById('hs-modal');
      var body = document.getElementById('hs-modal-body');
      var closeBtn = document.getElementById('hs-modal-close');

      document.querySelectorAll('[data-modal-target]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var src = document.getElementById(btn.dataset.modalTarget);
          body.innerHTML = src.innerHTML;
          overlay.removeAttribute('hidden');
          document.body.style.overflow = 'hidden';
        });
      });

      function closeModal() {
        overlay.setAttribute('hidden', '');
        body.innerHTML = '';
        document.body.style.overflow = '';
      }

      closeBtn.addEventListener('click', closeModal);
      overlay.addEventListener('click', function (e) {
        if (e.target === overlay) closeModal();
      });

      // Escape closes whichever is open
      document.addEventListener('keydown', function (e) {
        if (e.key !== 'Escape') return;
        if (!box.hasAttribute('hidden')) closeLightbox();
        if (!overlay.hasAttribute('hidden')) closeModal();
      });
    })();
  </script>
</body>
</html>
